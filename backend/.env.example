# MongoDB Connection String (required)
# For local: mongodb://127.0.0.1:27017/waleed_project
# For Atlas: Get from MongoDB Atlas dashboard
MONGODB_URI=mongodb://127.0.0.1:27017/waleed_project

# Server Port
PORT=5001

# JWT Secret - Use a strong, random string (min 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# CORS Origin - Frontend URL that's allowed to access this backend
CORS_ORIGIN=http://localhost:3000

# Environment
NODE_ENV=development
